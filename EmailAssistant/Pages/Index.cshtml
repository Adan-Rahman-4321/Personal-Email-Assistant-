@page
@model EmailAssistant.Pages.IndexModel
@{
    ViewData["Title"] = "AI Email Command Center";
}

<div class="dashboard-wrapper container-fluid px-lg-5 px-3 py-4">
    <!-- Top Hero / Command Bar -->
    <div class="dashboard-header-card p-4 mb-4 rounded-4 shadow-sm">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 rounded-pill fw-semibold">
                        <span class="pulse-dot me-1"></span> Native AI Engine Active
                    </span>
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1 rounded-pill">
                        100% On-Device Classification
                    </span>
                </div>
                <h1 class="dashboard-title h2 mb-1 fw-bold text-white">AI Email Command Center</h1>
                <p class="text-secondary mb-0 small">Real-time intelligent email classification, triage, and multi-category management</p>
            </div>
            
            <div class="d-flex align-items-center gap-2">
                <button id="btnFetchEmails" class="btn btn-primary px-3 py-2 fw-semibold d-flex align-items-center gap-2 shadow-sm rounded-3">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="7 10 12 15 17 10"/>
                        <line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                    <span>Fetch Emails</span>
                </button>
                <button id="btnRefresh" class="btn btn-outline-light px-3 py-2 fw-medium d-flex align-items-center gap-2 rounded-3">
                    <svg id="refreshIcon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <polyline points="23 4 23 10 17 10"/>
                        <polyline points="1 20 1 14 7 14"/>
                        <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
                    </svg>
                    <span>Refresh</span>
                </button>
            </div>
        </div>

        <!-- Metric Stat Cards Row -->
        <div class="row g-3 mt-3 pt-3 border-top border-secondary border-opacity-25">
            <div class="col-6 col-lg-3">
                <div class="stat-card p-3 rounded-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-secondary small fw-medium d-block">Total Emails</span>
                        <h3 class="mb-0 fw-bold text-white mt-1" id="totalEmailsCount">0</h3>
                    </div>
                    <div class="stat-icon bg-info bg-opacity-10 text-info rounded-3 p-2.5">
                        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <rect width="20" height="16" x="2" y="4" rx="2"/>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                        </svg>
                    </div>
                </div>
            </div>
            
            <div class="col-6 col-lg-3">
                <div class="stat-card p-3 rounded-3 d-flex align-items-center justify-content-between stat-danger">
                    <div>
                        <span class="text-secondary small fw-medium d-block">Most Important</span>
                        <h3 class="mb-0 fw-bold text-danger mt-1" id="statCountMostImportant">0</h3>
                    </div>
                    <div class="stat-icon bg-danger bg-opacity-10 text-danger rounded-3 p-2.5">
                        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
                        </svg>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="stat-card p-3 rounded-3 d-flex align-items-center justify-content-between stat-warning">
                    <div>
                        <span class="text-secondary small fw-medium d-block">Important</span>
                        <h3 class="mb-0 fw-bold text-warning mt-1" id="statCountImportant">0</h3>
                    </div>
                    <div class="stat-icon bg-warning bg-opacity-10 text-warning rounded-3 p-2.5">
                        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                        </svg>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="stat-card p-3 rounded-3 d-flex align-items-center justify-content-between stat-primary">
                    <div>
                        <span class="text-secondary small fw-medium d-block">Casual & Promo</span>
                        <h3 class="mb-0 fw-bold text-primary mt-1" id="statCountCasualPromo">0</h3>
                    </div>
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary rounded-3 p-2.5">
                        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Live Instant Filter Bar -->
        <div class="mt-3 pt-3 border-top border-secondary border-opacity-25">
            <div class="search-box position-relative">
                <svg class="search-icon position-absolute" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text" id="emailSearchInput" class="form-control ps-5 py-2.5 rounded-3 bg-dark bg-opacity-50 border-secondary border-opacity-50 text-white" placeholder="Search emails by sender, subject, or content across all panels in real-time...">
                <button id="btnClearSearch" class="btn btn-sm btn-link text-secondary position-absolute end-0 top-50 translate-middle-y me-2 text-decoration-none" style="display:none;">✕</button>
            </div>
        </div>
    </div>

    <!-- Category Columns Grid (4 Columns) -->
    <div class="row g-4 panels-grid">
        <!-- 1. Most Important Panel -->
        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="category-panel category-most-important d-flex flex-column h-100 rounded-4 shadow-sm" data-category="Most Important">
                <div class="category-panel-header p-3.5 d-flex justify-content-between align-items-center border-bottom">
                    <div class="d-flex align-items-center gap-2.5">
                        <span class="category-badge-icon bg-danger bg-opacity-15 text-danger rounded-2 p-1.5">🔥</span>
                        <div>
                            <h3 class="h6 mb-0 fw-bold text-white">Most Important</h3>
                            <span class="text-secondary extra-small">Urgent & Critical Action</span>
                        </div>
                    </div>
                    <span class="badge rounded-pill bg-danger bg-opacity-20 text-danger border border-danger border-opacity-25 email-count px-2.5 py-1" id="countMostImportant">0</span>
                </div>
                <div class="category-panel-body flex-grow-1 p-3 overflow-y-auto" id="panelMostImportant">
                    <div class="empty-state py-5 text-center">
                        <div class="empty-state-icon mb-2">🛡️</div>
                        <p class="empty-state-text text-secondary mb-0 small">No urgent emails</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Important Panel -->
        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="category-panel category-important d-flex flex-column h-100 rounded-4 shadow-sm" data-category="Important">
                <div class="category-panel-header p-3.5 d-flex justify-content-between align-items-center border-bottom">
                    <div class="d-flex align-items-center gap-2.5">
                        <span class="category-badge-icon bg-warning bg-opacity-15 text-warning rounded-2 p-1.5">⭐</span>
                        <div>
                            <h3 class="h6 mb-0 fw-bold text-white">Important</h3>
                            <span class="text-secondary extra-small">Work, Business & Meetings</span>
                        </div>
                    </div>
                    <span class="badge rounded-pill bg-warning bg-opacity-20 text-warning border border-warning border-opacity-25 email-count px-2.5 py-1" id="countImportant">0</span>
                </div>
                <div class="category-panel-body flex-grow-1 p-3 overflow-y-auto" id="panelImportant">
                    <div class="empty-state py-5 text-center">
                        <div class="empty-state-icon mb-2">📁</div>
                        <p class="empty-state-text text-secondary mb-0 small">No important emails</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Casual Panel -->
        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="category-panel category-casual d-flex flex-column h-100 rounded-4 shadow-sm" data-category="Casual">
                <div class="category-panel-header p-3.5 d-flex justify-content-between align-items-center border-bottom">
                    <div class="d-flex align-items-center gap-2.5">
                        <span class="category-badge-icon bg-primary bg-opacity-15 text-primary rounded-2 p-1.5">🙂</span>
                        <div>
                            <h3 class="h6 mb-0 fw-bold text-white">Casual</h3>
                            <span class="text-secondary extra-small">Personal & Social Updates</span>
                        </div>
                    </div>
                    <span class="badge rounded-pill bg-primary bg-opacity-20 text-primary border border-primary border-opacity-25 email-count px-2.5 py-1" id="countCasual">0</span>
                </div>
                <div class="category-panel-body flex-grow-1 p-3 overflow-y-auto" id="panelCasual">
                    <div class="empty-state py-5 text-center">
                        <div class="empty-state-icon mb-2">☕</div>
                        <p class="empty-state-text text-secondary mb-0 small">No casual emails</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Promotional Panel -->
        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="category-panel category-promotional d-flex flex-column h-100 rounded-4 shadow-sm" data-category="Promotional">
                <div class="category-panel-header p-3.5 d-flex justify-content-between align-items-center border-bottom">
                    <div class="d-flex align-items-center gap-2.5">
                        <span class="category-badge-icon bg-secondary bg-opacity-15 text-secondary rounded-2 p-1.5">🏷️</span>
                        <div>
                            <h3 class="h6 mb-0 fw-bold text-white">Promotional</h3>
                            <span class="text-secondary extra-small">Sales, Offers & Newsletters</span>
                        </div>
                    </div>
                    <span class="badge rounded-pill bg-secondary bg-opacity-20 text-light border border-secondary border-opacity-25 email-count px-2.5 py-1" id="countPromotional">0</span>
                </div>
                <div class="category-panel-body flex-grow-1 p-3 overflow-y-auto" id="panelPromotional">
                    <div class="empty-state py-5 text-center">
                        <div class="empty-state-icon mb-2">🛍️</div>
                        <p class="empty-state-text text-secondary mb-0 small">No promotional emails</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Email Detail Modal -->
<div class="modal fade" id="emailDetailModal" tabindex="-1" aria-labelledby="emailDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4 border border-secondary border-opacity-25 shadow-lg">
            <div class="modal-header border-bottom border-secondary border-opacity-25 px-4 py-3">
                <div class="d-flex align-items-center gap-2">
                    <span id="modalCategoryBadge" class="badge rounded-pill px-3 py-1.5">Category</span>
                    <span id="modalProviderBadge" class="badge bg-dark border border-secondary border-opacity-50 text-secondary rounded-pill px-2.5 py-1">Provider</span>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="emailDetailContent">
                <!-- Content dynamically populated -->
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25 px-4 py-3 d-flex justify-content-between">
                <button type="button" class="btn btn-outline-info d-flex align-items-center gap-2 rounded-3" id="btnReclassify">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
                    </svg>
                    <span>Reclassify with AI</span>
                </button>
                <button type="button" class="btn btn-secondary px-4 rounded-3" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Fetch Emails Modal (Real Providers Only - No Mock) -->
<div class="modal fade" id="fetchModal" tabindex="-1" aria-labelledby="fetchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border border-secondary border-opacity-25 shadow-lg">
            <div class="modal-header border-bottom border-secondary border-opacity-25 px-4 py-3">
                <h5 class="modal-title fw-bold text-white d-flex align-items-center gap-2" id="fetchModalLabel">
                    <span>📥</span> Fetch & Classify Real Emails
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-4">
                    <label class="form-label text-secondary small fw-bold text-uppercase">Select Email Provider</label>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="provider-option-card d-block p-3 rounded-3 border border-secondary border-opacity-50 text-center cursor-pointer active" for="providerGmail">
                                <input type="radio" class="d-none" name="emailProviderRadio" id="providerGmail" value="Gmail" checked>
                                <div class="provider-icon fs-2 mb-1">📧</div>
                                <div class="fw-bold text-white">Gmail</div>
                                <div class="text-secondary extra-small">Google Workspace</div>
                            </label>
                        </div>
                        <div class="col-6">
                            <label class="provider-option-card d-block p-3 rounded-3 border border-secondary border-opacity-50 text-center cursor-pointer" for="providerOutlook">
                                <input type="radio" class="d-none" name="emailProviderRadio" id="providerOutlook" value="Outlook">
                                <div class="provider-icon fs-2 mb-1">📨</div>
                                <div class="fw-bold text-white">Outlook</div>
                                <div class="text-secondary extra-small">Microsoft 365</div>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="fetchCount" class="form-label text-secondary small fw-bold text-uppercase">Number of Emails to Fetch</label>
                    <div class="input-group">
                        <input type="number" id="fetchCount" class="form-control py-2.5 rounded-3 bg-dark bg-opacity-50 border-secondary border-opacity-50 text-white" value="20" min="1" max="50">
                        <span class="input-group-text bg-dark bg-opacity-50 border-secondary border-opacity-50 text-secondary">messages</span>
                    </div>
                </div>

                <div class="alert alert-dark border border-secondary border-opacity-25 rounded-3 py-2.5 px-3 mb-0">
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-info fs-5">ℹ️</span>
                        <div class="extra-small text-secondary">
                            Emails fetched from your inbox will be evaluated in real-time by the native C# AI classifier and organized into the 4 category panels.
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25 px-4 py-3">
                <button type="button" class="btn btn-outline-secondary px-3 rounded-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary px-4 fw-semibold rounded-3 d-flex align-items-center gap-2" id="btnExecuteFetch">
                    <span>Fetch & Classify</span>
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <line x1="5" y1="12" x2="19" y2="12"/>
                        <polyline points="12 5 19 12 12 19"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Loading Overlay -->
<div id="loadingSpinner" class="loading-overlay" style="display: none;">
    <div class="loading-card p-4 rounded-4 shadow-lg text-center border border-secondary border-opacity-25">
        <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <h5 class="text-white fw-bold mb-1" id="loadingTitle">Processing Emails</h5>
        <p class="text-secondary small mb-0" id="loadingSubtitle">Native AI Classification Engine is sorting emails...</p>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js"></script>
}
